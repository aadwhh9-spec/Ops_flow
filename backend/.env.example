# PostgreSQL connection used by the API and Drizzle migrations.
DATABASE_URL=postgresql://postgres:password@localhost:5432/opsflow

# Use a long random value outside local development.
JWT_SECRET=replace-with-a-long-random-secret

# The first account registered with this email receives the admin role.
OWNER_OPEN_ID=admin@example.com

PORT=4000
NODE_ENV=development

# Optional: enables the AI assistant.
GEMINI_API_KEY=

# Optional in development; required to email password reset codes in production.
RESEND_API_KEY=
RESET_EMAIL_FROM=OpsFlow <no-reply@example.com>
